@page "/user/orders"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IGetCustomerOrdersUseCase GetGetCustomerOrdersUseCase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Orders</PageTitle>

<div class="container">

    <h2>Orders</h2>
    <hr />
    @if (!_isReady)
    {
        <p>Loading...</p>
    }
    else
    {
        <Grid TItem="Order"
              Class="table table-hover table-bordered table-striped"
              DataProvider="OrdersDataProvider"
              AllowFiltering="false"
              AllowPaging="false"
              AllowSorting="false"
              Responsive="true">

            <GridColumn TItem="Order" HeaderText="Id" PropertyName="Id" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                @context.Id
            </GridColumn>
            <GridColumn TItem="Order" HeaderText="First Name" PropertyName="FirstName" SortString="FirstName">
                @context.FirstName
            </GridColumn>
            <GridColumn TItem="Order" HeaderText="Last Name" PropertyName="LastName">
                @context.LastName
            </GridColumn>
            <GridColumn TItem="Order" HeaderText="Total" PropertyName="Total">
                $@GetPriceDisplay(context.Total)
            </GridColumn>
            <GridColumn TItem="Order" HeaderText="Create Date" PropertyName="CreateDate">
                @GetDateDisplay(context.CreateDate)
            </GridColumn>
            <GridColumn TItem="Order" HeaderText="Create Time" PropertyName="CreateDate">
                @GetTimeDisplay(context.CreateDate)
            </GridColumn>
            <GridColumn TItem="Order" HeaderText="TransactionId" PropertyName="TransactionId">
                @context.TransactionId
            </GridColumn>
            <GridColumn TItem="Order" HeaderText="TransactionStatus" PropertyName="TransactionStatus">
                @context.TransactionStatus
            </GridColumn>
            <GridColumn TItem="Order" HeaderText="Actions">
                <a href="@($"/user/orders/details?id={context.Id}")" class="text-info">Details</a>
            </GridColumn>


        </Grid>
    }
</div>
@code {
    private int _userId;
    private bool _isReady;

    private string GetDateDisplay(DateTime? date) => date.HasValue ? date.Value.ToString("yyyy/MM/dd") : "";

    private string GetTimeDisplay(DateTime? date) => date.HasValue ? date.Value.ToString("hh:mm") : "";

    private string GetPriceDisplay(decimal? price) => price?.ToString("F");

    protected override async Task OnInitializedAsync()
    {
        _userId = await GetUserIdAsync();
        _isReady = true;
    }

    private async Task<int> GetUserIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdClaim, out int userId) == true)
            {
                return userId;
            }
        }
        return 0;
    }

    private async Task<GridDataProviderResult<Order>> OrdersDataProvider(GridDataProviderRequest<Order> request)
    {
        if (_userId <= 0)
        {
            return new GridDataProviderResult<Order>
            {
                Data = Enumerable.Empty<Order>(),
                TotalCount = 0
            };
        }
        var orders = await GetGetCustomerOrdersUseCase.ExecuteAsync(_userId);
        return await Task.FromResult(new GridDataProviderResult<Order> { Data = orders, TotalCount = orders.Count() });
    }

}
