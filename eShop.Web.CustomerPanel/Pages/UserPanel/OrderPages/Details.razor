@page "/user/orders/details"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IGetCustomerOrderByIdUseCase GetCustomerOrderById
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]


<PageTitle>Details</PageTitle>
<div class="container">

   
    @if (order is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <h3>Prodduct Details</h3>
        <hr />
        <table class="table table-responsive">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Price</th>
                    <th>Count</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in OrderDetails)
                {
                    <tr>
                        <td>@item.ProductTitle</td>
                        <td>$@item.ProductPrice.ToString("F")</td>
                        <td>@item.Count</td>
                        <td>$@((item.Count * item.ProductPrice).ToString("F"))</td>
                    </tr>
                }
            </tbody>
        </table>
        <br />
        <h3>Order Info</h3>
        <hr />
        <table class="table table-responsive">
            <tr>
                <th>Id</th>
                <td>@order.Id</td>
            </tr>
            <tr>
                <th>First Name</th>
                <td>@order.FirstName</td>
            </tr>
            <tr>
                <th>Last Name</th>
                <td>@order.LastName</td>
            </tr>
            <tr>
                <th>Company Name</th>
                <td>@order.CompanyName</td>
            </tr>
            <tr>
                <th>Country</th>
                <td>@order.Country</td>
            </tr>
            <tr>
                <th>City</th>
                <td>@order.City</td>
            </tr>
            <tr>
                <th>Address</th>
                <td>@order.Address</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>@order.Email</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>@order.Phone</td>
            </tr>
            <tr>
                <th>Comment</th>
                <td>@order.Comment</td>
            </tr>
            <tr>
                <th>کدتخفیف</th>
                <td>@order.CouponCode</td>
            </tr>
            <tr>
                <th>Coupon Discount</th>
                <td>@order.CouponDiscount</td>
            </tr>
            <tr>
                <th>هزینه ارسال</th>
                <td>@order.Shipping?.ToString("N0")</td>
            </tr>
            <tr>
                <th>SubTotal</th>
                <td>@order.SubTotal?.ToString("N0")</td>
            </tr>
            <tr>
                <th>Total</th>
                <td>@order.Total?.ToString("N0")</td>
            </tr>
            <tr>
                <th>CreateDate</th>
                <td>@order.CreateDate?.ToString("yyyy/MM/dd")</td>
            </tr>
            <tr>
                <th>TransactionId</th>
                <td>@order.TransactionId</td>
            </tr>
            <tr>
                <th>TransactionStatus</th>
                <td>@order.TransactionStatus</td>
            </tr>
        </table>

        <div>
            <a class="text-success" href="@($"/user/orders")">Back to List</a>
        </div>
    }
</div>
@code {
    private Order? order;

    [SupplyParameterFromQuery]
    private int Id { get; set; }
    private List<OrderDetail> OrderDetails;

    protected override async Task OnParametersSetAsync()
    {
        var userId = await GetUserIdAsync();
        try
        {
            OrderDetails = await GetCustomerOrderById.ExecuteAsync(Id, userId);
        }
        catch
        {
            NavigationManager.NavigateTo("notfound");
        }

    }
    private async Task<int> GetUserIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdClaim, out int userId) == true)
            {
                return userId;
            }
        }
        return 0;
    }
}
