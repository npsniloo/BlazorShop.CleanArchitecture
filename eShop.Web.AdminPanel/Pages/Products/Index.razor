@page "/Admin/products"
@inject IGetProductsUseCase GetProductsUseCase
@inject IOptions<ImagesSettings> Options
@rendermode InteractiveServer

<PageTitle>Products</PageTitle>

<h1>Products</h1>


<p>
    <a class="btn btn-info  p-1" href="admin/products/create">Create New</a>
</p>


<Grid TItem="Product"
      Class="table table-hover table-bordered table-striped"
      DataProvider="ProductsDataProvider"
      AllowFiltering="false"
      AllowPaging="false"
      AllowSorting="false"
      Responsive="true">

    <GridColumn TItem="Product" HeaderText="Id" PropertyName="Id" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
        @context.Id
    </GridColumn>
    <GridColumn TItem="Product" HeaderText="Title" PropertyName="Title" SortString="Title">
        @context.Title
    </GridColumn>
    <GridColumn TItem="Product" HeaderText="Price" PropertyName="Price">
        @context.Price
    </GridColumn>
    <GridColumn TItem="Product" HeaderText="Discount" PropertyName="Discount">
        @context.Discount
    </GridColumn>
    <GridColumn TItem="Product" HeaderText="Image" PropertyName="Image">
        <img src="@GetPath(@context.ImageName)" alt="@@context.Title" style="max-width:100px" />
    </GridColumn>
    <GridColumn TItem="Product" HeaderText="Actions">
        <a href="@($"/admin/products/details/{context.Id}")" class="btn btn-sm btn-info me-1">Details</a>
        <a href="@($"/admin/products/edit/{context.Id}")" class="btn btn-sm btn-warning me-1">Edit</a>
        <a href="@($"/admin/products/delete/{context.Id}")" class="btn btn-sm btn-warning me-1">Delete</a>
    </GridColumn>


</Grid>


@code {
    private string GetPath(string image)
    {

        return Options.Value.ProductsPath + image;
    }
    private async Task<GridDataProviderResult<Product>> ProductsDataProvider(GridDataProviderRequest<Product> request)
    {
        var Products = await GetProductsUseCase.ExecuteAsync();
        return await Task.FromResult(new GridDataProviderResult<Product> { Data = Products, TotalCount = Products.Count() });
    }
}


